# Copy to .env and fill in. .env is gitignored. Never commit real keys.

# --- Razorpay (TEST MODE ONLY) ---------------------------------------------
# Dashboard -> Account & Settings -> API Keys, with the mode toggle on Test.
# Test keys start with rzp_test_. If yours starts with rzp_live_, stop.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# Set when you create the webhook in the Razorpay dashboard (Phase 4).
RAZORPAY_WEBHOOK_SECRET=

# Public URL your tunnel exposes for webhook/app.py, e.g. from
#   cloudflared tunnel --url http://localhost:8000
RAZORPAY_CALLBACK_BASE_URL=https://example.invalid

# Live payment-link budget for a run. Test mode caps this at 30 per business
# unless Razorpay Support raises it. See docs/ISSUES.md ISS-001.
RECOUP_LIVE_LINK_BUDGET=30

# --- Anthropic --------------------------------------------------------------
# Leave UNSET deliberately to exercise the deterministic fallback path.
# The full batch must complete with no key present. See Phase 3 gate.
ANTHROPIC_API_KEY=

# --- Run configuration ------------------------------------------------------
RECOUP_SEED=42
RECOUP_EXECUTOR=simulated        # simulated | live
RECOUP_TICKS=112                 # 1 tick = 6 virtual hours; 112 = 28 virtual days
